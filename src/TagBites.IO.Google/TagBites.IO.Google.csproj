<Project Sdk="Microsoft.NET.Sdk">

  <!-- Targets -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>TagBites.IO.Google</RootNamespace>
  </PropertyGroup>

  <!-- Build -->
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Package info -->
  <PropertyGroup>
    <Description>Google Cloud Storage file system support for TagBites.IO. Browse, read and write a Google Cloud Storage bucket through the same FileSystem API used for local disk and other storages.</Description>
    <PackageTags>file;files;filesystem;storage;sync;google-cloud-storage;gcs</PackageTags>
    <PackageProjectUrl>https://www.tagbites.com/io</PackageProjectUrl>
  </PropertyGroup>

  <!-- References -->
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)\src\TagBites.IO\TagBites.IO.csproj" Condition="$(SolutionName.EndsWith('-dev'))" />
    <PackageReference Include="TagBites.IO" Version="2.0.0" Condition="!$(SolutionName.EndsWith('-dev'))" />
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.15.0" />
  </ItemGroup>

</Project>
